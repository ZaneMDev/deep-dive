generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "mysql"
}

model User {
    // Identifiers
    id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt
    publicId String @unique @db.VarChar(12)

    // User Data
    email    String  @unique @db.VarChar(255)
    username String  @unique @db.VarChar(20)
    password String  @db.VarChar(255)
    bio      String? @db.VarChar(200)

    // Relations
    createdGroups Group[]       @relation("GroupCreator")
    groupsJoined  GroupMember[]
    posts         Post[]
    comments      Comment[]

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Group {
    // Identifiers
    id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt
    publicId String @unique @db.VarChar(12)

    // Group Data
    name        String  @unique @db.VarChar(25)
    description String? @db.VarChar(500)

    // Relations
    creatorId BigInt        @db.UnsignedBigInt
    creator   User          @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
    members   GroupMember[]
    posts     Post[]

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model GroupMember {
    // Identifiers & Foreign Keys
    userId  BigInt @db.UnsignedBigInt
    groupId BigInt @db.UnsignedBigInt

    // Relations
    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

    // Timestamps
    joinedAt DateTime @default(now())

    // Metadata
    @@id([userId, groupId])
    @@index([groupId])
}

model Post {
    // Identifiers & Foreign Keys
    id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt
    publicId String @unique @db.VarChar(12)
    authorId BigInt @db.UnsignedBigInt
    groupId  BigInt @db.UnsignedBigInt

    // Post Data
    title    String  @db.VarChar(100)
    body     String? @db.VarChar(1000)
    isEdited Boolean @default(false)

    // Relations
    author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
    group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
    comments Comment[]

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Metadata
    @@index([authorId])
    @@index([groupId])
}

model Comment {
    // Identifiers & Foreign Keys
    id       BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
    publicId String  @unique @db.VarChar(12)
    authorId BigInt  @db.UnsignedBigInt
    postId   BigInt  @db.UnsignedBigInt
    parentId BigInt? @db.UnsignedBigInt

    // Comment Data
    content  String  @db.VarChar(1000)
    isEdited Boolean @default(false)

    // Relations
    author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
    post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
    parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    replies Comment[] @relation("CommentReplies")

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Metadata
    @@index([authorId])
    @@index([postId])
    @@index([parentId])
}
